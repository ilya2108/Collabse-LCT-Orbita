# Шаблон окружения docker compose (дев-стенд «Орбита ФСП»). `make dev-env` копирует его в
# deploy/compose/.env и заменяет плейсхолдеры __GEN_*__ на случайные значения.
# .env — в .gitignore; ключи ПДн стабильны между запусками (файл не перетирается).

# PostgreSQL (одна инстанция, две БД: fsp — приложение, keycloak — IAM). Пароль dev-стенда
# статичен ради запуска backend на хосте (DATABASE_URL в backend/.env), поэтому порт
# публикуется только на 127.0.0.1 (docker-compose.dev.yml)
POSTGRES_USER=fsp
POSTGRES_PASSWORD=fsp

# Keycloak: bootstrap-админ консоли (realm master, http://localhost:8080) — генерируется
KC_ADMIN_PASSWORD=__GEN_PWD_KCADMIN__
# Демо-администратор realm fsp (пользователь fsp-admin; роль admin приходит только из токена);
# генерируется под passwordPolicy realm (length(10) and notUsername and notEmail) —
# значение смотрите в deploy/compose/.env после `make dev-env`
DEMO_ADMIN_PASSWORD=__GEN_PWD_DEMOADMIN__
# Публичный URL фронта: redirect URI Keycloak, CORS backend'а, ссылки в ответах API
FRONTEND_PUBLIC_URL=http://localhost:5173

# Шифрование ПДн (152-ФЗ): генерируются автоматически, в git не попадают
PII_FERNET_KEYS=__GEN_FERNET_PII__
PII_HMAC_KEY=__GEN_B64_PIIHMAC__

# Межсервисная аутентификация (джобы, импорт, заглушка реестра ФСП): X-Internal-Token
INTERNAL_API_TOKEN=__GEN_HEX_INTERNAL__

# Секрет confidential-клиента Keycloak fsp-backend-admin (подставляется в realm при импорте)
BACKEND_ADMIN_CLIENT_SECRET=__GEN_HEX_BACKENDADMIN__

# LLM-конвейер: stub — без ключей (CI, локальная разработка); gigachat — основной провайдер;
# yandex — резерв; replay — ответы из репозитория; rules — словарь ключевых слов
LLM_PROVIDER=stub
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL_STRONG=GigaChat-2-Pro
GIGACHAT_MODEL_FAST=GigaChat-2-Lite
# TLS к API Сбера подписан НУЦ Минцифры: путь к PEM-бандлу (root+sub, gu-st.ru).
# В прод-контейнере бандл монтируется в /certs (CERTS_DIR хоста, по умолчанию /opt/certs).
GIGACHAT_CA_BUNDLE=/certs/russian_trusted_bundle.pem
GIGACHAT_VERIFY_SSL_CERTS=true
YC_FOLDER_ID=
YC_API_KEY=
YANDEX_MODEL=yandexgpt
LLM_DAILY_TOKEN_CAP=2000000
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=60

# Тестирование: демо-режим (укороченная сессия, короткий cooldown) и ограничения
TEST_DEMO_MODE=false
DEMO_COOLDOWN_SECONDS=300
GRADE_COOLDOWN_DAYS=90

# Телеграм-бот: stub — без сети и токена (исходящие в tg_outbox); polling — реальный бот
# (TELEGRAM_BOT_TOKEN от @BotFather, TELEGRAM_BOT_USERNAME — имя бота без @)
TELEGRAM_BOT_MODE=stub
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=OrbitaFspBot

# --- Прод-стенд (docker-compose.prod.yml: Caddy с авто-TLS) — заполняется руками на VPS ---
# Публичный домен стенда: A-запись на IP VPS или nip.io (например orbita.185.0.0.1.nip.io)
PUBLIC_DOMAIN=
# Email для Let's Encrypt (уведомления об истечении сертификата)
ACME_EMAIL=
# «Почта стенда» https://<домен>/mail/ (пользователь mail): bcrypt-хэш пароля для Caddy.
# Генерация СРАЗУ с удвоением $ (docker compose разворачивает $$ → $):
#   docker run --rm caddy:2 caddy hash-password --plaintext 'ваш-пароль' | sed 's/\$/$$/g'
MAILPIT_BASIC_AUTH=
