# Шаблон переменных окружения для запуска backend ПРЯМО НА ХОСТЕ (без Docker):
#   cp .env.example backend/.env && make dev-infra && cd backend && .venv/bin/uvicorn app.main:app --reload
# pydantic-settings читает `.env` из текущей директории — файл должен лежать в backend/.
# Для docker compose используется свой файл deploy/compose/.env (генерируется `make dev-env`).
# Полный список переменных с дефолтами — backend/app/core/config.py.

APP_ENV=dev
LOG_LEVEL=INFO
# публичный адрес фронта: CORS в dev и ссылки в ответах API
FRONTEND_PUBLIC_URL=http://localhost:5173

# PostgreSQL (compose пробрасывает 5432 на localhost)
DATABASE_URL=postgresql+asyncpg://fsp:fsp@localhost:5432/fsp

# Keycloak (realm fsp; в dev браузер и backend видят его на localhost:8080)
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_ISSUER=http://localhost:8080/realms/fsp
KEYCLOAK_REALM=fsp
KEYCLOAK_AUDIENCES=account,fsp-frontend
# confidential-клиент Admin API (опционален); секрет — BACKEND_ADMIN_CLIENT_SECRET из deploy/compose/.env
KEYCLOAK_ADMIN_CLIENT_ID=fsp-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Шифрование ПДн (152-ФЗ). Сгенерировать:
#   PII_FERNET_KEYS: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   PII_HMAC_KEY:    openssl rand -base64 32
# Либо взять значения из deploy/compose/.env — тогда одна БД читается и с хоста, и из контейнера.
PII_FERNET_KEYS=
PII_HMAC_KEY=

# Межсервисная аутентификация (джобы, импорт, заглушка реестра ФСП): X-Internal-Token
INTERNAL_API_TOKEN=dev-internal-token

# LLM-конвейер: stub — без ключей; gigachat — основной; yandex — резерв; replay; rules
LLM_PROVIDER=stub
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL_STRONG=GigaChat-2-Pro
GIGACHAT_MODEL_FAST=GigaChat-2-Lite
# TLS к API Сбера подписан НУЦ Минцифры: путь к PEM-бандлу (root+sub, gu-st.ru).
# В прод-контейнере бандл монтируется в /certs (CERTS_DIR хоста, по умолчанию /opt/certs).
GIGACHAT_CA_BUNDLE=
GIGACHAT_VERIFY_SSL_CERTS=true
YC_FOLDER_ID=
YC_API_KEY=
YANDEX_MODEL=yandexgpt
LLM_DAILY_TOKEN_CAP=2000000
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=60

# Телеграм-бот «ФСП.Орбита» (python -m app.tools.bot): stub — без сети и токена,
# исходящие пишутся в tg_outbox; polling — реальный бот (токен у @BotFather)
TELEGRAM_BOT_MODE=stub
TELEGRAM_BOT_TOKEN=
# username бота без @ — для deep-link привязки https://t.me/<бот>?start=<код>
TELEGRAM_BOT_USERNAME=OrbitaFspBot
# недельный дайджест: день недели (0 — понедельник … 6) и час UTC
DIGEST_CRON_WEEKDAY=0
DIGEST_CRON_HOUR=9
# Mini App: срок годности initData (секунды от auth_date подписи Telegram)
TMA_INIT_DATA_TTL_SECONDS=3600

# Справочник навыков (YAML): относительный путь — от корня backend
SKILLS_DIR=app/skills

# Тестирование: демо-режим и ограничения
TEST_DEMO_MODE=false
DEMO_COOLDOWN_SECONDS=300
GRADE_COOLDOWN_DAYS=90

# Сигналы целостности тестовой сессии (пороги флагов; калибровка — по данным пилота)
INTEGRITY_PASTE_LEN=200
INTEGRITY_BLUR_SECONDS=5
INTEGRITY_MIN_SECONDS_PER_ITEM=20
INTEGRITY_NO_EDIT_MIN_LEN=120
INTEGRITY_MAX_BATCH_EVENTS=500
